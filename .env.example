# Put your Kaggle account token in the shell or private .env.
KAGGLE_API_TOKEN=
# Temporary credentials from `kaggle benchmarks auth -y --env-file .env`:
MODEL_PROXY_URL=
MODEL_PROXY_API_KEY=
MODEL_PROXY_EXPIRY_TIME=
# Copy local model configuration from `kaggle benchmarks init -y`:
LLMS_AVAILABLE=
LLM_DEFAULT=
# Optional:
FRONTIER_LOG_DIR=logs
