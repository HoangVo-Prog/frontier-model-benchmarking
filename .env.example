# Pick ONE credential style. This file is read-only to frontier.
# Style A: one account
# KAGGLE_API_TOKEN=KGAT_your_token_here

# Style B: paste many tokens on one line (aliases account_1, account_2).
# KAGGLE_API_TOKENS=KGAT_first_token,KGAT_second_token

# Style C: ordered, named accounts; first with remaining quota is used.

# KAGGLE_ACCOUNTS=primary,backup
# KAGGLE_API_TOKEN_PRIMARY=
# KAGGLE_API_TOKEN_BACKUP=

# Only local Model Proxy model IDs, separated by commas.
LLMS_AVAILABLE=
# Optional, must be one of LLMS_AVAILABLE; client sets a fallback if missing.
LLM_DEFAULT=

# Automatic switch when any Kaggle quota period has <= this USD remaining.
FRONTIER_MIN_REMAINING_USD=0.05
# Cache API quota responses per process for this many seconds (0 = no cache).
FRONTIER_QUOTA_CACHE_SECONDS=30
FRONTIER_LOG_DIR=logs
