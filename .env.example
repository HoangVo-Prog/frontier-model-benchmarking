# Optional. Obtain Kaggle Model Proxy credentials with:
# kaggle benchmarks auth -y --env-file .env
# Never commit the populated .env file.
# Kaggle account access can use `kaggle auth login` or KAGGLE_USERNAME/KAGGLE_KEY.
# Temporary Kaggle Model Proxy credentials are separate; populate them with:
# kaggle benchmarks auth -y --env-file .env
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
MODEL_PROXY_API_KEY=
MODEL_PROXY_URL=
FRONTIER_MODEL=
FRONTIER_DATASET_PATH=
FRONTIER_OUTPUT_DIR=./runs
